#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Build Magnetar as an Arch package and install it, so it shows in the app launcher.
# pacman asks for your password: run this in your own terminal.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root/pkgbuild"
exec makepkg -fsi "$@"
