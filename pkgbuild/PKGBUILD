# SPDX-License-Identifier: GPL-3.0-or-later
# Builds Magnetar from this checkout and installs it with its launcher entry and icon, plus the
# akkoctl CLI, the udev rule and the Omarchy bar widget (linked into ~/.config by bin/package).
# Run bin/package (makepkg -fsi): pacman asks for your password to install.
pkgname=magnetar
pkgver=0.1.0
pkgrel=1
pkgdesc='Unofficial configurator for the Akko TAC75 HE magnetic keyboard'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'libpulse' 'systemd-libs' 'libxkbcommon' 'wayland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/app/magnetar "$pkgdir/usr/bin/magnetar"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/magnetar.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/magnetar.svg"
  install -Dm644 "$startdir/magnetar.desktop" "$pkgdir/usr/share/applications/magnetar.desktop"
  install -Dm755 build/cli/akkoctl "$pkgdir/usr/bin/akkoctl"
  install -Dm644 udev/70-akko-tac75-he.rules "$pkgdir/usr/lib/udev/rules.d/70-akko-tac75-he.rules"
  local widget="$pkgdir/usr/share/magnetar/omarchy-widget/boudbois.akko"
  install -Dm644 omarchy-widget/boudbois.akko/manifest.json "$widget/manifest.json"
  install -Dm644 omarchy-widget/boudbois.akko/Panel.qml "$widget/Panel.qml"
}
